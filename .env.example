# Optional: YouTube Channel ID (e.g. UCxxxxxxxxxxxxxxxxxxxxxx).
# If omitted, Chasing 606's latest upload is automatically discovered from @Chasing606.
YOUTUBE_CHANNEL_ID=

# Optional Shopify connector. Leave BOTH blank to keep preview mode.
# Use a public Storefront API access token from the Headless sales channel, NOT an Admin API token.
# Set the token as a Cloudflare runtime secret; never prefix it with VITE_.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10
# Enable only after checking the catalog, shipping/tax, inventory and test checkout.
SHOPIFY_CHECKOUT_ENABLED=false
# Enable new customer accounts and Shop Pay in Shopify before switching this on.
SHOPIFY_CUSTOMER_ACCOUNTS_ENABLED=false
# Optional: paste the customer account URL from Shopify Settings > Customer accounts.
SHOPIFY_CUSTOMER_ACCOUNT_URL=
