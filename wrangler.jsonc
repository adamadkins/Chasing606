{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chasing606",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths get index.html so the client-side router can render them.
    "not_found_handling": "single-page-application",
    // Only API calls run the Worker; everything else is served straight from assets.
    "run_worker_first": ["/api/*"]
  },
  // Order records (payment id -> supplier order) so a repeated Stripe webhook never ships twice.
  // Wrangler creates this database automatically on the first deploy.
  "d1_databases": [{ "binding": "DB" }],
  "build": {
    "command": "npm run build"
  }
}
